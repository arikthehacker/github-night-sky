{
  "manifest_version": 3,
  "name": "GitHub Night Sky",
  "version": "1.0.0",
  "description": "A soft, sparkly nighttime sky behind GitHub.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://gist.github.com/*"],
      "css": ["stars.css", "theme.css"],
      "js": ["theme.js"],
      "run_at": "document_start"
    }
  ]
}
